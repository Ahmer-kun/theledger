# Copy this file to `.env.local` and fill in real values.
# Never commit `.env.local` — only `.env.example` / `.env.local.example` are tracked.

# Next.js — the public origin of the deployed app (used for OAuth redirects and canonical URLs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase — project URL, from Dashboard > Project Settings > API (the "Project Ref" URL).
NEXT_PUBLIC_SUPABASE_URL=

# Supabase — public anon key ("publishable" client key). Safe for the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — service role key. SERVER-ONLY, never expose it to the browser.
# Powers server-side ingestion, storage, and admin operations in later phases.
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio — Gemini API key (free tier) for vision extraction of receipt images.
GEMINI_API_KEY=

# Google AI Studio — Gemini model (default: gemini-3.6-flash).
# GEMINI_MODEL=gemini-3.6-flash

# Groq — API key (free tier) for fast grounded Q&A generation in the chat.
GROQ_API_KEY=